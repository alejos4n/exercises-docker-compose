services:
  backend:
    build:
      context: ../example-app
      dockerfile: Dockerfile.backend
    ports:
      - "8080:8080"
    environment:
      - PORT=8080
      - REQUEST_ORIGIN=http://localhost:5001
      - REDIS_HOST=redis_cache
    restart: unless-stopped
    depends_on:
      - redis_cache

  frontend:
    build:
      context: ../example-app
      dockerfile: Dockerfile.frontend
    ports:
      - "5001:5001" # <-- Cambiado de 5000:5000 a 5001:5001
    environment:
      - REACT_APP_BACKEND_URL=http://localhost:8080
    depends_on:
      - backend

  redis_cache:
    image: redis:7-alpine
